<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Snapshots">
	<description>Sniffs for WordPress plugins</description>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress.WP.I18n"/>
	<config name="text_domain" value="snapshots"/>

	<rule ref="PEAR.Functions.FunctionCallSignature">
		<properties>
			<property name="allowMultipleArguments" value="false"/>
		</properties>
	</rule>

	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="EverPress"/>
				<element value="snapshots"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="snapshots"/>
			</property>
		</properties>
	</rule>

	<arg value="ps"/>
	<arg name="extensions" value="php,css,scss/css"/>
	<!-- Never add <arg name="parallel" …/> — hangs / times out on many machines. -->

	<!-- Rules: WordPress Coding Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards/wiki/Customizable-sniff-properties -->
	<config name="minimum_supported_wp_version" value="6.6"/>
	<file>./</file>
	<exclude-pattern>*/classes/libs/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<exclude-pattern>*/assets/css/libs/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

</ruleset>
